			"Resource": [
				"arn:aws:s3:::pvk123/*"
			]
		},
		{
			"Sid": "listingAllBuckets",
			"Effect": "Allow",
			"Action": [
				"s3:ListAllMyBuckets"
			],
			"Resource": [
				"*"
			]
		}
	]
}

